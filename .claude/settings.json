{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 1000000,
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -lc 'command -v jq >/dev/null 2>&1 || exit 0; input=$(cat); project_dir=$(printf \"%s\" \"$input\" | jq -r \".workspace.project_dir // empty\"); script=\"$project_dir/.claude/statusline/statusline.sh\"; if [ -n \"$project_dir\" ] && [ -f \"$script\" ]; then printf \"%s\" \"$input\" | bash \"$script\"; fi'"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/enforce-venv.sh"},
          {"type": "command", "command": ".claude/hooks/block-branch-create-in-primary.sh"},
          {"type": "command", "command": ".claude/hooks/block-direct-commit-on-main.sh"},
          {"type": "command", "command": ".claude/hooks/inject-codex-danger-mode.sh"},
          {"type": "command", "command": ".claude/hooks/block-content-merge-without-learner-check.sh"},
          {"type": "command", "command": ".claude/hooks/block-bugfix-merge-without-regression-test.sh"}
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/block-orchestrator-content-edits.sh"}
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/block-agent-worktree-isolation.sh"}
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/pre-read-warn-large-log.sh"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{"type": "command", "command": ".claude/hooks/context-monitor.sh"}]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/post-write-py-autoformat.sh"}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"type": "command", "command": ".claude/hooks/session-setup.sh"}]
      }
    ],
    "PostCompact": [
      {
        "hooks": [{"type": "command", "command": ".claude/hooks/post-compact.sh"}]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(npm run *)",
      "Bash(make *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip install *)",
      "Bash(pip show *)",
      "Bash(source .venv/bin/activate *)",
      "Bash(mkdocs *)",
      "Bash(bash *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(curl *)",
      "Bash(chmod *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(kill *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(sleep *)",
      "Bash(test *)",
      "Bash(echo *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(npx markdownlint-cli2 *)",
      "Bash(scripts/ab *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  }
}
